# Database connection string (SQLite for zero-config local, or PostgreSQL e.g. postgresql://user:pass@host:5432/db)
DATABASE_URL="file:./dev.db"

# Set a unique admin password (at least 12 characters) before seeding.
ADMIN_INITIAL_CODE="choose-a-unique-admin-password-before-seeding"

# Generate a unique random secret of at least 32 characters.
JWT_SECRET="generate-a-random-secret-of-at-least-32-characters"
